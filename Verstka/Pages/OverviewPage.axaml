<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
             x:Class="Verstka.Pages.OverviewPage">

    <UserControl.Styles>
        <Style Selector="Border.selected-day">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.selected-day-text">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.calendar-day">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0,7,0,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28"
                    Spacing="14"
                    MaxWidth="1120"
                    HorizontalAlignment="Stretch">

            <TextBlock Text="Обзор"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <Grid ColumnDefinitions="*,*,*,*" Margin="0,6,0,0">

                <Border Classes="card" Margin="0,0,10,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Проекты" />
                        <TextBlock Text="12" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Classes="muted"
                                   Text="Активных проектов"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card" Margin="0,0,10,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Задачи" />
                        <TextBlock Text="48" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="В работе" FontSize="13" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="card" Margin="0,0,10,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Команда" />
                        <TextBlock Text="8" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="Участников" FontSize="13" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="muted" Text="Сроки" />
                        <TextBlock Text="5"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Просрочено"
                                   FontSize="13"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </Border>

            </Grid>

            <Grid ColumnDefinitions="*,334">

                <StackPanel Spacing="12" Margin="0,0,10,0">

                    <Border Classes="card">
                        <StackPanel Spacing="13">

                            <TextBlock Text="Активные проекты"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="3*,2*,42" RowDefinitions="Auto,Auto">
                                <TextBlock Text="Avalonia UI Redesign"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        CornerRadius="5" Padding="8,3"
                                        Background="{DynamicResource PrimarySoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Дизайн"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>

                                <ProgressBar Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                             Value="65"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,15,0,0"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="65%"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" />

                            <Grid ColumnDefinitions="3*,2*,42" RowDefinitions="Auto,Auto">
                                <TextBlock Text="Мобильное приложение"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        CornerRadius="5" Padding="8,3"
                                        Background="{DynamicResource InfoSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Разработка"
                                               FontSize="12"
                                               Foreground="{DynamicResource InfoBrush}" />
                                </Border>

                                <ProgressBar Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                             Value="40"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,15,0,0"
                                             Foreground="{DynamicResource InfoBrush}"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="40%"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" />

                            <Grid ColumnDefinitions="3*,2*,42" RowDefinitions="Auto,Auto">
                                <TextBlock Text="Корпоративный сайт"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1"
                                        CornerRadius="5" Padding="8,3"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="Разработка"
                                               FontSize="12"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Border>

                                <ProgressBar Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                             Value="80"
                                             Maximum="100"
                                             Height="6"
                                             Margin="0,15,0,0"
                                             Foreground="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="80%"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="12">

                            <TextBlock Text="Последние задачи"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="Auto,*,Auto,80">
                                <CheckBox Width="20" Height="32" MinWidth="0" Padding="0"
                                          CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Разработать макет главной страницы"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        CornerRadius="5" Padding="8,3"
                                        Background="{DynamicResource PrimarySoftBrush}"
                                        Margin="4,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Дизайн"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>

                                <TextBlock Grid.Column="3"
                                           Classes="muted"
                                           Text="15.05.2024"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto,80">
                                <CheckBox Width="20" Height="32" MinWidth="0" Padding="0"
                                          CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Реализовать авторизацию"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        CornerRadius="5" Padding="8,3"
                                        Background="{DynamicResource InfoSoftBrush}"
                                        Margin="4,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Разработка"
                                               FontSize="12"
                                               Foreground="{DynamicResource InfoBrush}" />
                                </Border>
                                <TextBlock Grid.Column="3"
                                           Classes="muted"
                                           Text="14.05.2024"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto,80">
                                <CheckBox Width="20" Height="32" MinWidth="0" Padding="0"
                                          CornerRadius="2" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Подготовить презентацию"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        CornerRadius="5" Padding="8,3"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        Margin="4,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Маркетинг"
                                               FontSize="12"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                                <TextBlock Grid.Column="3"
                                           Classes="muted"
                                           Text="13.05.2024"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <Border Grid.Column="1"
                        Classes="card"
                        VerticalAlignment="Top">

                    <StackPanel Spacing="10">
                        <TextBlock Text="Календарь"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <StackPanel Width="294"
                                    Spacing="8"
                                    HorizontalAlignment="Center">

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="‹"
                                           FontSize="20"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="Октябрь 2026 г."
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="20"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <primitives:UniformGrid Columns="7">
                                <TextBlock Classes="muted" Text="Пн" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Вт" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Ср" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Чт" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Пт" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Сб" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Classes="muted" Text="Вс" FontSize="12" HorizontalAlignment="Center" />
                            </primitives:UniformGrid>

                            <primitives:UniformGrid Columns="7">
                                <Border Width="34" Height="34" />
                                <Border Width="34" Height="34" />
                                <Border Width="34" Height="34" />

                                <TextBlock Classes="calendar-day" Text="1" />
                                <TextBlock Classes="calendar-day" Text="2" />
                                <TextBlock Classes="calendar-day" Text="3" />
                                <TextBlock Classes="calendar-day" Text="4" />
                                <TextBlock Classes="calendar-day" Text="5" />

                                <Border Classes="selected-day"
                                        Width="34"
                                        Height="25"
                                        CornerRadius="9"
                                        HorizontalAlignment="Center">
                                    <TextBlock Classes="selected-day-text"
                                               Text="6"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Classes="calendar-day" Text="7" />
                                <TextBlock Classes="calendar-day" Text="8" />
                                <TextBlock Classes="calendar-day" Text="9" />
                                <TextBlock Classes="calendar-day" Text="10" />
                                <TextBlock Classes="calendar-day" Text="11" />
                                <TextBlock Classes="calendar-day" Text="12" />
                                <TextBlock Classes="calendar-day" Text="13" />
                                <TextBlock Classes="calendar-day" Text="14" />
                                <TextBlock Classes="calendar-day" Text="15" />
                                <TextBlock Classes="calendar-day" Text="16" />
                                <TextBlock Classes="calendar-day" Text="17" />
                                <TextBlock Classes="calendar-day" Text="18" />
                                <TextBlock Classes="calendar-day" Text="19" />
                                <TextBlock Classes="calendar-day" Text="20" />
                                <TextBlock Classes="calendar-day" Text="21" />
                                <TextBlock Classes="calendar-day" Text="22" />
                                <TextBlock Classes="calendar-day" Text="23" />
                                <TextBlock Classes="calendar-day" Text="24" />
                                <TextBlock Classes="calendar-day" Text="25" />
                                <TextBlock Classes="calendar-day" Text="26" />
                                <TextBlock Classes="calendar-day" Text="27" />
                                <TextBlock Classes="calendar-day" Text="28" />
                                <TextBlock Classes="calendar-day" Text="29" />
                                <TextBlock Classes="calendar-day" Text="30" />
                                <TextBlock Classes="calendar-day" Text="31" />

                                <Border Width="34" Height="34" />
                            </primitives:UniformGrid>

                        </StackPanel>
                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
