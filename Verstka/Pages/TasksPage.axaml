<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Verstka.Pages.TasksPage">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14" MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Classes="heading" Text="Задачи" />
            <Border Classes="card" Margin="0,6,0,0">
                <StackPanel Spacing="13">
                    <TextBlock Classes="section" Text="Список задач" FontSize="16" />
                    <Grid ColumnDefinitions="Auto,*,Auto,90" Margin="0,6">
                        <CheckBox Width="20" Height="32" MinWidth="0" Padding="0"
                                  CornerRadius="2" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Разработать макет главной страницы" Margin="12,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="2" CornerRadius="5" Padding="8,3" Margin="4,0,12,0" VerticalAlignment="Center" Background="{DynamicResource PrimarySoftBrush}">
                            <TextBlock Text="Дизайн"  FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="3" Classes="muted" Text="15.05.2024" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,90" Margin="0,6">
                        <CheckBox Width="20" Height="32" MinWidth="0" Padding="0"
                                  CornerRadius="2" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Реализовать авторизацию" Margin="12,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="2" CornerRadius="5" Padding="8,3" Margin="4,0,12,0" VerticalAlignment="Center" Background="{DynamicResource InfoSoftBrush}">
                            <TextBlock Text="Разработка"  FontSize="12" Foreground="{DynamicResource InfoBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="3" Classes="muted" Text="14.05.2024" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,90" Margin="0,6">
                        <CheckBox Width="20" Height="32" MinWidth="0" Padding="0"
                                  CornerRadius="2" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Подготовить презентацию" Margin="12,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="2" CornerRadius="5" Padding="8,3" Margin="4,0,12,0" VerticalAlignment="Center" Background="{DynamicResource SuccessSoftBrush}">
                            <TextBlock Text="Маркетинг"  FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="3" Classes="muted" Text="13.05.2024" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

