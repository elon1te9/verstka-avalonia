<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Verstka.Pages.SettingsPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14" MaxWidth="1120" HorizontalAlignment="Stretch">
            <TextBlock Classes="heading" Text="Настройки" />
            <Border Classes="card" Margin="0,6,0,0">
                <StackPanel Spacing="14">
                    <TextBlock Classes="section" Text="Внешний вид" />
                    <ToggleSwitch x:Name="ThemeSwitch"
                                  OnContent="Включена" OffContent="Выключена"
                                  HorizontalAlignment="Left"
                                  IsCheckedChanged="ThemeSwitch_Changed" />
                    <TextBlock x:Name="ThemeText" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

